{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "target": "es2022",

    "strict": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
  
    "types": ["node"],

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },

  "include": ["src"]
}
